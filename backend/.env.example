# Copy to `.env` for local development. In production (Render) set these
# in the dashboard instead — never commit the real .env.

# --- Server ---
PORT=5000

# --- Local MySQL (default) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hostel_complaints
DB_SSL=false

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Create tables + seed demo accounts automatically when the server starts.
# Leave false locally (run `npm run init-db` once); set true in production.
INIT_DB_ON_BOOT=false

# --- For a cloud MySQL like TiDB Cloud Serverless, use values like ---
# DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxx.root
# DB_PASSWORD=your-tidb-password
# DB_NAME=hostel_complaints
# DB_SSL=true
